model Device {
    id          Int     @id @default(autoincrement())
    name        String
    state       Boolean @default(false)
    type        String

    color       String?
    rpm         Int?
    temperature Float?

    userId Int
    user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
    id        Int      @id @default(autoincrement())
    name      String
    email     String   @unique
    password  String
    createdAt DateTime @default(now())

    devices   Device[]
}